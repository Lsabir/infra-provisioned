# Example values for terraform.tfvars

prefix = "vmubuntu-dev"
location = "germanywestcentral"
tags = {
  project     = "vm-ubuntu-storage"
  environment = "dev"
  owner       = "devops-team"
}

backend_resource_group_name  = "example-backend-rg"
backend_storage_account_name = "examplebackendstorage"
backend_container_name       = "tfstate"
backend_key                  = "terraform.tfstate"

vm_size          = "Standard_B2s"
os_disk_size_gb  = 30
data_disk_size_gb = 100
os_image         = "ubuntu-22.04"
existing_network_id = "/subscriptions/<subscription_id>/resourceGroups/<resource_group>/providers/Microsoft.Network/virtualNetworks/<vnet_name>"
existing_subnet_id  = "/subscriptions/<subscription_id>/resourceGroups/<resource_group>/providers/Microsoft.Network/virtualNetworks/<vnet_name>/subnets/<subnet_name>"
ssh_public_key = "ssh-rsa AAAAB3...example-key"
