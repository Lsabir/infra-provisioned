# Example tfvars file for Terraform

prefix = "projet-dev"
location = "germanywestcentral"
tags = {
  project     = "existing-project"
  environment = "dev"
  owner       = "devops-team"
}

backend_resource_group_name  = "example-backend-rg"
backend_storage_account_name = "examplebackendstorage"
backend_container_name       = "tfstate"
backend_key                  = "terraform.tfstate"

vm_size = "Standard_B2s"
os_disk_size_gb = 30
data_disk_size_gb = 100

existing_network_id = "example-vnet-id"
existing_subnet_id = "example-subnet-id"

ubuntu_vm_size = "Standard_B2s"
ubuntu_os_disk_size_gb = 30
ubuntu_managed_disk_type = "Standard_LRS"
ubuntu_network_interface_id = "reuse-existing-nic-id"
