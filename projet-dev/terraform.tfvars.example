# Example values for Terraform variables

# Prefix for naming resources
prefix = "projet-dev"

# Azure region where resources will be deployed
location = "germanywestcentral"

# Tags to apply to all resources
tags = {
  project     = "projet"
  environment = "dev"
  owner       = "devops-team"
}

# Address space for the virtual network
vnet_address_space = "10.0.0.0/16"

# Address prefix for the default subnet
subnet_default_address_prefix = "10.0.1.0/24"

# Size of the virtual machine
vm_size = "Standard_B2s"

# Admin username for the virtual machine
vm_admin_username = "adminuser"

# Disk size in GB for the virtual machine
vm_disk_size_gb = 30

# Terraform backend configuration
backend_resource_group_name  = "example-backend-rg"
backend_storage_account_name = "examplebackendstorage"
backend_container_name       = "tfstate"
backend_key                  = "terraform.tfstate"
